		itemDef
		{
			name			"bz_pap_footer_bg"
			rect			72 354 496 48
			style			WINDOW_STYLE_FILLED
			backcolor		0.07 0.08 0.14 0.95
			border			1
			bordersize		1
			bordercolor		0.80 0.50 1.0 0.40
			visible			1
			decoration
		}
		itemDef
		{
			name			"bz_pap_feedback"
			type			ITEM_TYPE_TEXT
			rect			86 366 362 24
			exp				text( dvarString( "ui_bz_feedback" ) );
			textfont		UI_FONT_NORMAL
			textscale		0.25
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textalign		ITEM_ALIGN_LEFT
			textaligny		16
			forecolor		0.85 0.95 1.0 1
			visible			1
			decoration
		}
		itemDef
		{
			name			"btn_pap_close"
			type			ITEM_TYPE_BUTTON
			rect			454 363 102 28
			style			WINDOW_STYLE_FILLED
			backcolor		0.24 0.10 0.10 0.95
			border			1
			bordersize		1
			bordercolor		0.95 0.45 0.45 0.70
			text			"CLOSE [ESC]"
			textfont		UI_FONT_NORMAL
			textscale		0.26
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textalign		ITEM_ALIGN_CENTER
			textaligny		19
			forecolor		1 1 1 1
			visible			1
			mouseEnter		{ play "mouse_over"; }
			action
