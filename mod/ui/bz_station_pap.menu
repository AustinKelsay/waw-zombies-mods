		// Tier 2 Double Pack-a-Punch (5000)
		itemDef
		{
			name			"btn_pap_double"
			type			ITEM_TYPE_BUTTON
			rect			88 258 464 74
			style			WINDOW_STYLE_FILLED
			backcolor		0.18 0.10 0.20 0.92
			border			1
			bordersize		1
			bordercolor		1.0 0.55 0.85 0.55
			text			"Double Pack-a-Punch (5000)"
			textfont		UI_FONT_NORMAL
			textscale		0.30
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textalign		ITEM_ALIGN_LEFT
			textalignx		12
			textaligny		24
			forecolor		1 1 1 1
			visible			1
			mouseEnter		{ play "mouse_over"; }
