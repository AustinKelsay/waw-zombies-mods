#include "ui/menudef.h"

// Base Zombies - Arsenal & Squad Station Popup (Call of Duty: WaW 1.7)
// Phase 1 exposes PaP Knife, PaP Bowie Knife, and PaP Cluster Grenade, plus
// clearly marked read-only sections for Phase 2 Elemental Weapons & Phase 3 Companions.
// Strictly ASCII-only strings and balanced braces.

{
	menuDef
	{
		name			"bz_station_arsenal"
		fullscreen		0
		rect			0 0 640 480
		focuscolor		1 0.85 0.35 1
		style			WINDOW_STYLE_EMPTY
		border			0
		onEsc
		{
			play "mouse_click";
			scriptMenuResponse "close";
			close self;
		}

		itemDef
		{
			name			"bz_arsenal_bg"
			rect			44 38 552 404
			style			WINDOW_STYLE_FILLED
			backcolor		0.04 0.06 0.09 0.92
			border			1
			bordersize		1
			bordercolor		0.45 0.88 1.0 0.65
			visible			1
			decoration
		}

