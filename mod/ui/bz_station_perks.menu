#include "ui/menudef.h"

// Base Zombies - Specialty Perk Station Popup (Call of Duty: WaW 1.7)
// Non-fullscreen, per-player Co-op safe clickable shop menu.
// Strictly ASCII-only strings and balanced braces.

{
	menuDef
	{
		name			"bz_station_perks"
		fullscreen		0
		rect			0 0 640 480
		focuscolor		1 0.85 0.35 1
		style			WINDOW_STYLE_EMPTY
		border			0
		onEsc
		{
			play "mouse_click";
			scriptMenuResponse "close";
			close self;
		}

		// Main dark shop backdrop
		itemDef
		{
			name			"bz_perks_bg"
			rect			16 26 608 428
			style			WINDOW_STYLE_FILLED
			backcolor		0.04 0.06 0.09 0.92
			border			1
			bordersize		1
			bordercolor		0.45 0.88 1.0 0.65
			visible			1
			decoration
		}

		// Header bar
		itemDef
		{
			name			"bz_perks_header_bg"
